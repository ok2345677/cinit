#!/bin/sh
# udevd — устройство-менеджер (devtmpfs + hotplug)
#
#  Void (eudev):    /usr/libexec/eudev/udevd      [*] установлено
#  Arch (systemd):  /usr/lib/systemd/systemd-udevd — НЕ использовать,
#                   ставить как systemd-сервис (systemd-udevd.service)
#  Gentoo (eudev):  /usr/libexec/eudev/udevd
case $1 in
start)
	/usr/libexec/eudev/udevd &
	( sleep 1; udevadm trigger --action=add --type=subsystems; udevadm trigger --action=add --type=devices; udevadm settle --timeout=30 ) &
	wait
	;;
stop) pkill -f eudev/udevd ;;
esac