#!/bin/sh
# tty — виртуальные терминалы (agetty): tty1 автоматин-login vova, tty2 обычный
#  Arch/systemd:  systemctl enable --now getty@tty1.service (автологин:
#                 /etc/systemd/system/getty@tty1.service.d/autologin.conf)
#  Void:          изменить юзера vova -> твой; uid 1000 тем же
case $1 in
start)
	mkdir -p /run/user/1000
	chown 1000:1000 /run/user/1000 && chmod 0700 /run/user/1000
	( while :; do /usr/bin/agetty --noclear tty2 38400 linux || sleep 1; done ) &
	exec /bin/sh -c 'while :; do /usr/bin/agetty --autologin vova --noclear tty1 38400 linux || sleep 1; done'
	;;
stop) pkill agetty ;;
esac