#!/bin/sh
# dbus — системная шина сообщений (обязательна для многих сервисов)
#  Arch/systemd:  systemctl enable --now dbus.service
#  Void/Gentoo:   dbus пакет; /run/dbus создаёт сам
case $1 in
start)
	mkdir -p /run/dbus
	chown dbus:dbus /run/dbus
	exec dbus-daemon --system --nofork --nopidfile
	;;
stop) pkill dbus-daemon ;;
esac