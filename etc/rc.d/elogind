#!/bin/sh
# elogind — logind без systemd (сессии/питание для X11/Wayland)
#  Arch:          logind ВСТРОЕН в systemd — elogind НЕ нужен
#  Void/Gentoo:   elogind пакет (на dbus-магистраль ждёт шину)
case $1 in
start)
	i=0
	while [ ! -S /run/dbus/system_bus_socket ] && [ $i -lt 50 ]; do
		i=$((i+1))
		sleep 0.1
	done
	exec /usr/libexec/elogind/elogind.wrapper
	;;
stop) pkill elogind ;;
esac